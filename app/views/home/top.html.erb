<% content_for :stylesheet do %>
  <%= stylesheet_link_tag "home_top", "data-turbo-track": "reload" %>
<% end %>

<div class="home-top-page">
  <div class="top-visual">
    <p class="top-subtitle">RECORD YOUR JOURNEY</p>

    <h1>Travel Blog</h1>

    <p class="top-description">
      旅行の思い出やスケジュールを、<br>
      しおり形式で記録できるアプリ
    </p>

    <div class="top-buttons">
      <% if user_signed_in? %>
        <%= link_to "マイページへ",
                    mypage_path,
                    class: "button" %>

        <%= button_to "ログアウト",
                      destroy_user_session_path,
                      method: :delete,
                      class: "button secondary-button" %>
      <% else %>
        <%= link_to "新規登録",
                    new_user_registration_path,
                    class: "button" %>

        <%= link_to "ログイン",
                    new_user_session_path,
                    class: "button secondary-button" %>
      <% end %>
    </div>
  </div>
</div>